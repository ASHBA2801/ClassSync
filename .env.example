# Neon PostgreSQL — from Neon dashboard → Connection details
# Pooled connection (host ends with -pooler) — used by the Express API at runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection (no -pooler) — required for Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Backend server port
PORT=5000

# Mobile app — use your PC's Wi-Fi IP (not localhost) on a physical device
EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
        