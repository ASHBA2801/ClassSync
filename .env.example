DATABASE_URL=postgresql://user:password@localhost:5432/classsync
# Used only for rate-limiting/idempotency in the web app (no longer a job queue).
REDIS_URL=redis://localhost:6379
AUTH_SECRET=generate-a-secure-random-string-here
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=classsync-uploads
S3_ENDPOINT=              # Optional: http://localhost:9000 for MinIO (docker-compose)
# Face recognition — AWS Rekognition (cloud). Uses AWS credentials or EC2 IAM role.
# Set FACE_PROVIDER=mock for local dev without Rekognition access.
FACE_PROVIDER=aws
# Per-school Razorpay keys are configured in Admin → Settings (not here).
# Use rzp_test_* keys from https://dashboard.razorpay.com for test mode.
RAZORPAY_PLATFORM_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@classsync.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id

# --- Worker service (background jobs — Cloud Run or a second Vercel project) ---
# Base URL of the deployed worker (web app -> worker).
WORKER_URL=http://localhost:3001
# Shared secret; must match on both the web app and the worker.
WORKER_SECRET=generate-a-secure-random-string-here
# Set this on the WORKER deployment only (not on the web app). Makes shared
# lib code (e.g. notifications) call functions directly instead of dispatching
# another HTTP request back to itself. `npm run worker` sets this automatically.
# WORKER_ROLE=worker
