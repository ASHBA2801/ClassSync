generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STAFF
  PARENT
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum PlanTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum LeaveRequesterType {
  TEACHER
  STAFF
  PARENT
}

enum EmployeeJobType {
  TEACHER
  CLASS_TEACHER
  PET_MASTER
  LIBRARIAN
  LAB_ASSISTANT
  SPORTS_COACH
  ACCOUNTANT
  OFFICE_CLERK
  RECEPTIONIST
  VAN_DRIVER
  BUS_DRIVER
  TRANSPORT_COORDINATOR
  SECURITY_GUARD
  SECURITY_SUPERVISOR
  CLEANER
  JANITOR
  GARDENER
  MAINTENANCE_STAFF
  CANTEEN_STAFF
  NURSE
  COUNSELLOR
  PRINCIPAL
  VICE_PRINCIPAL
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

enum PaymentFrequency {
  MONTHLY
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

enum SalaryPayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum StaffAttendanceStatus {
  PROCESSING
  PRESENT
  FAILED
  ESCALATED
  ABSENT
  LATE
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  REGULAR
  OD
}

enum LeaveAllowancePeriod {
  MONTH
  YEAR
}

enum ScheduleAlterationType {
  LEAVE_SUBSTITUTION
  SWAP
  ADMIN_OVERRIDE
}

enum ScheduleAlterationStatus {
  ACTIVE
  CANCELLED
}

enum ScheduleSwapType {
  COMPLEMENTARY_FREE
  PARALLEL_SECTIONS
}

enum TeacherAttendanceStatus {
  PROCESSING
  PRESENT
  FAILED
  ESCALATED
  ABSENT
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  BIRTH_CERTIFICATE
  COMMUNITY_CERTIFICATE
  MARKSHEET
}

enum UploaderType {
  PARENT
  TEACHER
}

enum FeeInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  PHONEPE
  PAYPAL
  STRIPE
}

enum CoreSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CoreInvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationChannel {
  WEB_PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model School {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  timezone        String       @default("Asia/Kolkata")
  campusLat       Float?
  campusLng       Float?
  campusRadiusM   Int          @default(200)
  planTier        PlanTier     @default(BASIC)
  status          SchoolStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships         UserSchoolMembership[]
  students            Student[]
  grades              Grade[]
  classSections       ClassSection[]
  subjects            Subject[]
  teacherAssignments  TeacherAssignment[]
  scheduleSlots       ScheduleSlot[]
  scheduleConstraints ScheduleConstraint[]
  scheduleConfig      SchoolScheduleConfig?
  scheduleVersions    ScheduleVersion[]
  scheduleAlterations ScheduleAlteration[]
  scheduleSwapGroups  ScheduleSwapGroup[]
  teacherAlterationStats TeacherAlterationStat[]
  periodTimings       PeriodTiming[]
  teacherAttendances  TeacherAttendance[]
  studentAttendances  StudentAttendance[]
  leaveRequests       LeaveRequest[]
  documents           Document[]
  feeStructures       FeeStructure[]
  feeInvoices         FeeInvoice[]
  payments            Payment[]
  paymentProviders    SchoolPaymentProviderConfig[]
  notificationLogs    NotificationLog[]
  auditLogs           AuditLog[]
  aiServiceKeys       AIServiceKey[]
  pushSubscriptions   PushSubscription[]
  employees           Employee[]
  employeeSalaries    EmployeeSalary[]
  employeeBankAccounts EmployeeBankAccount[]
  payrollRuns         PayrollRun[]
  salaryPayouts       SalaryPayout[]
  payoutConfig        SchoolPayoutConfig?
  employeeJobTypeConfigs SchoolEmployeeJobTypeConfig[]
  transportRoutes     TransportRoute[]
  securityVisitorLogs SecurityVisitorLog[]
  cleanerZoneAssignments CleanerZoneAssignment[]
  sportsSchedules     SportsSchedule[]
  libraryBooks        LibraryBook[]
  staffAttendances    StaffAttendance[]
  calendarDays        SchoolCalendarDay[]
  coreSubscription    SchoolSubscription?
  coreModuleInvoices  CoreModuleInvoice[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  faceImageKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           UserSchoolMembership[]
  guardianRelationships GuardianRelationship[]
  teacherAssignments    TeacherAssignment[]
  teacherAttendances    TeacherAttendance[]
  leaveRequests         LeaveRequest[]
  scheduleAlterationsCreated ScheduleAlteration[] @relation("AlterationCreator")
  scheduleSwapGroupsCreated  ScheduleSwapGroup[]  @relation("SwapGroupCreator")
  teacherAlterationStats     TeacherAlterationStat[]
  pushSubscriptions     PushSubscription[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  employee              Employee[]
  payrollRunsApproved   PayrollRun[]           @relation("PayrollApprover")
  transportRouteAssignments TransportRouteAssignment[]
  staffAttendances      StaffAttendance[]
  securityVisitorLogs   SecurityVisitorLog[]   @relation("SecurityVisitorLogger")
}

model UserSchoolMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  schoolId  String   @db.Uuid
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, role])
  @@index([schoolId, role])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  role         Role
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  classSectionId String?  @db.Uuid
  name           String
  dob            DateTime?
  admissionNo    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection          ClassSection?          @relation(fields: [classSectionId], references: [id])
  guardianRelationships GuardianRelationship[]
  studentAttendances    StudentAttendance[]
  leaveRequests         LeaveRequest[]
  documents             Document[]
  feeInvoices           FeeInvoice[]

  @@index([schoolId])
  @@index([classSectionId])
}

model GuardianRelationship {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  parentId  String   @db.Uuid
  studentId String   @db.Uuid
  relation  String   @default("guardian")
  createdAt DateTime @default(now())

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([schoolId])
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSections  ClassSection[]
  subjects       Subject[]
  feeStructures  FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSection {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  gradeId   String   @db.Uuid
  name      String
  grade     String
  section   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeRef           Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  students           Student[]
  teacherAssignments TeacherAssignment[]
  scheduleSlots      ScheduleSlot[]
  scheduleAlterations ScheduleAlteration[]
  feeStructures      FeeStructure[]

  @@unique([schoolId, gradeId, section])
  @@index([schoolId])
  @@index([gradeId])
}

model Subject {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  gradeId        String   @db.Uuid
  name           String
  code           String?
  periodsPerWeek Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade              Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  scheduleSlots      ScheduleSlot[]
  scheduleAlterations ScheduleAlteration[]

  @@unique([gradeId, name])
  @@index([schoolId])
  @@index([gradeId])
}

model TeacherAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  teacherId      String   @db.Uuid
  classSectionId String   @db.Uuid
  subjectId      String   @db.Uuid
  periodsPerWeek Int?
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classSectionId, subjectId])
  @@index([schoolId])
}

model PeriodTiming {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  periodNo  Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, periodNo])
}

model ScheduleVersion {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  version   Int
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheduleSlots ScheduleSlot[]

  @@unique([schoolId, version])
}

model ScheduleSlot {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  versionId      String   @db.Uuid
  dayOfWeek      Int
  periodNo       Int
  teacherId      String   @db.Uuid
  classSectionId String   @db.Uuid
  subjectId      String   @db.Uuid
  createdAt      DateTime @default(now())

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version      ScheduleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  classSection ClassSection    @relation(fields: [classSectionId], references: [id])
  subject      Subject         @relation(fields: [subjectId], references: [id])

  @@unique([versionId, dayOfWeek, periodNo, classSectionId])
  @@index([schoolId, teacherId])
}

model ScheduleConstraint {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  teacherId      String?  @db.Uuid
  /// Minimum free periods per week. Default 1; set to 0 to disable the minimum.
  minFreePerWeek Int      @default(1)
  maxFreePerWeek Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId])
}

model SchoolScheduleConfig {
  id                        String @id @default(uuid()) @db.Uuid
  schoolId                  String @unique @db.Uuid
  daysPerWeek               Int    @default(5)
  workingDays               Int[]  @default([0, 1, 2, 3, 4])
  maxSameSubjectPerDay      Int    @default(2)
  maxConsecutiveSameSubject Int    @default(3)
  requireFullSectionWeek    Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model TeacherAttendance {
  id        String                  @id @default(uuid()) @db.Uuid
  schoolId  String                  @db.Uuid
  teacherId String                  @db.Uuid
  date      DateTime                @db.Date
  status    TeacherAttendanceStatus @default(PROCESSING)
  markedAt  DateTime?
  geoLat    Float?
  geoLng    Float?
  method    String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher  User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attempts AttendanceAttempt[]

  @@unique([schoolId, teacherId, date])
  @@index([schoolId, date])
}

model AttendanceAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  teacherAttendanceId String   @db.Uuid
  attemptNumber       Int
  success             Boolean  @default(false)
  geoLat              Float?
  geoLng              Float?
  evidenceImageKey    String?
  errorMessage        String?
  createdAt           DateTime @default(now())

  teacherAttendance TeacherAttendance @relation(fields: [teacherAttendanceId], references: [id], onDelete: Cascade)

  @@index([teacherAttendanceId])
}

model StudentAttendance {
  id        String                  @id @default(uuid()) @db.Uuid
  schoolId  String                  @db.Uuid
  studentId String                  @db.Uuid
  date      DateTime                @db.Date
  status    StudentAttendanceStatus
  markedBy  String?                 @db.Uuid
  createdAt DateTime                @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, date])
  @@index([schoolId, date])
}

model LeaveRequest {
  id            String             @id @default(uuid()) @db.Uuid
  schoolId      String             @db.Uuid
  requesterId   String             @db.Uuid
  requesterType LeaveRequesterType
  studentId     String?            @db.Uuid
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String
  leaveType     LeaveType          @default(REGULAR)
  status        LeaveStatus        @default(PENDING)
  reviewedBy    String?            @db.Uuid
  reviewedAt    DateTime?
  reviewNote              String?
  substitutionsGenerated  Boolean            @default(false)
  alteredClassCount       Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requester    User                 @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  student      Student?             @relation(fields: [studentId], references: [id])
  alterations  ScheduleAlteration[]

  @@index([schoolId, status])
}

model ScheduleSwapGroup {
  id         String           @id @default(uuid()) @db.Uuid
  schoolId   String           @db.Uuid
  type       ScheduleSwapType
  teacherAId String           @db.Uuid
  teacherBId String           @db.Uuid
  note       String?
  createdBy  String           @db.Uuid
  createdAt  DateTime         @default(now())

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator      User                 @relation("SwapGroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  alterations  ScheduleAlteration[]

  @@index([schoolId])
}

model ScheduleAlteration {
  id                  String                   @id @default(uuid()) @db.Uuid
  schoolId            String                   @db.Uuid
  date                DateTime                 @db.Date
  periodNo            Int
  classSectionId      String                   @db.Uuid
  subjectId           String                   @db.Uuid
  originalTeacherId   String                   @db.Uuid
  substituteTeacherId String                   @db.Uuid
  type                ScheduleAlterationType
  priorityLevel       Int?
  leaveRequestId      String?                  @db.Uuid
  swapGroupId         String?                  @db.Uuid
  status              ScheduleAlterationStatus @default(ACTIVE)
  createdBy           String                   @db.Uuid
  createdAt           DateTime                 @default(now())

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection ClassSection       @relation(fields: [classSectionId], references: [id])
  subject      Subject            @relation(fields: [subjectId], references: [id])
  leaveRequest LeaveRequest?      @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  swapGroup    ScheduleSwapGroup? @relation(fields: [swapGroupId], references: [id], onDelete: SetNull)
  creator      User               @relation("AlterationCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([schoolId, date, periodNo, classSectionId, status])
  @@index([schoolId, date])
  @@index([schoolId, originalTeacherId])
  @@index([schoolId, substituteTeacherId])
  @@index([leaveRequestId])
  @@index([swapGroupId])
}

model TeacherAlterationStat {
  id                     String   @id @default(uuid()) @db.Uuid
  schoolId               String   @db.Uuid
  teacherId              String   @db.Uuid
  asSubstituteCount      Int      @default(0)
  classesAlteredForCount Int      @default(0)
  updatedAt              DateTime @updatedAt

  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId])
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  schoolId   String         @db.Uuid
  studentId  String         @db.Uuid
  uploadedBy String         @db.Uuid
  name       String
  s3Key      String
  mimeType   String
  documentType DocumentType?
  uploaderType UploaderType @default(PARENT)
  extracted   Json?
  extractionConfidence Float?
  status     DocumentStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

model FeeStructure {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @db.Uuid
  name           String
  amount         Decimal   @db.Decimal(10, 2)
  gradeId        String?   @db.Uuid
  classSectionId String?   @db.Uuid
  termStart      DateTime?
  termEnd        DateTime?
  createdAt      DateTime  @default(now())

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade        Grade?        @relation(fields: [gradeId], references: [id])
  classSection ClassSection? @relation(fields: [classSectionId], references: [id])
  feeInvoices  FeeInvoice[]

  @@index([schoolId])
  @@index([gradeId])
}

model FeeInvoice {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  feeStructureId String           @db.Uuid
  amount         Decimal          @db.Decimal(10, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(10, 2)
  status         FeeInvoiceStatus @default(POSTED)
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  @@index([schoolId, status])
}

model Payment {
  id                 String           @id @default(uuid()) @db.Uuid
  schoolId           String           @db.Uuid
  feeInvoiceId       String           @db.Uuid
  amount             Decimal          @db.Decimal(10, 2)
  status             PaymentStatus    @default(PENDING)
  provider           PaymentProvider?
  externalOrderId    String?
  externalPaymentId  String?          @unique
  receiptUrl         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id])

  @@index([schoolId])
  @@index([externalOrderId])
}

model SchoolPaymentProviderConfig {
  id                     String          @id @default(uuid()) @db.Uuid
  schoolId               String          @db.Uuid
  provider               PaymentProvider
  isEnabled              Boolean         @default(true)
  publicKey              String
  secretEncrypted        String
  webhookSecretEncrypted String?
  configJson             Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
  @@index([schoolId])
}

model CorePricingPlan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  maxUsers    Int
  priceAmount Decimal  @db.Decimal(10, 2)
  currency    String   @default("INR")
  interval    String   @default("YEAR")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions SchoolSubscription[]
  invoices      CoreModuleInvoice[]

  @@index([isActive, sortOrder])
}

model SchoolSubscription {
  id                 String                 @id @default(uuid()) @db.Uuid
  schoolId           String                 @unique @db.Uuid
  planId             String                 @db.Uuid
  status             CoreSubscriptionStatus @default(ACTIVE)
  userLimit          Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   CorePricingPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
}

model CoreModuleInvoice {
  id                String            @id @default(uuid()) @db.Uuid
  schoolId          String            @db.Uuid
  planId            String            @db.Uuid
  amount            Decimal           @db.Decimal(10, 2)
  status            CoreInvoiceStatus @default(PENDING)
  provider          PaymentProvider?
  externalOrderId   String?
  externalPaymentId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  paidAt            DateTime?

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   CorePricingPlan @relation(fields: [planId], references: [id])

  @@index([schoolId, status])
  @@index([externalOrderId])
}

model AIServiceKey {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @db.Uuid
  provider     String
  keyEncrypted String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@index([provider, schoolId])
}

model NotificationLog {
  id        String              @id @default(uuid()) @db.Uuid
  schoolId  String              @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  metadata  Json?
  createdAt DateTime            @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  schoolId  String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String?  @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
  actor  User    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([schoolId, createdAt])
  @@index([actorId])
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  schoolId          String           @db.Uuid
  userId            String           @db.Uuid
  employeeCode      String
  jobType           EmployeeJobType
  department        String?
  employmentStatus  EmploymentStatus @default(ACTIVE)
  dateOfJoining     DateTime         @db.Date
  dateOfLeaving     DateTime?        @db.Date
  emergencyContact  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaries          EmployeeSalary[]
  bankAccounts      EmployeeBankAccount[]
  salaryPayouts     SalaryPayout[]
  transportRoutes   TransportRouteAssignment[]
  cleanerZones      CleanerZoneAssignment[]
  staffAttendances  StaffAttendance[]

  @@unique([schoolId, userId])
  @@unique([schoolId, employeeCode])
  @@index([schoolId, jobType])
  @@index([schoolId, employmentStatus])
}

model EmployeeSalary {
  id               String           @id @default(uuid()) @db.Uuid
  schoolId         String           @db.Uuid
  employeeId       String           @db.Uuid
  baseSalary       Decimal          @db.Decimal(12, 2)
  allowances       Json             @default("{}")
  deductions       Json             @default("{}")
  effectiveFrom    DateTime         @db.Date
  effectiveTo      DateTime?        @db.Date
  paymentFrequency PaymentFrequency @default(MONTHLY)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId, employeeId])
  @@index([employeeId, effectiveFrom])
}

model EmployeeBankAccount {
  id                      String    @id @default(uuid()) @db.Uuid
  schoolId                String    @db.Uuid
  employeeId              String    @db.Uuid
  accountHolder           String
  accountNumberEncrypted  String
  ifscEncrypted           String
  upiIdEncrypted          String?
  bankName                String?
  razorpayContactId       String?
  razorpayFundAccountId   String?
  isVerified              Boolean   @default(false)
  verifiedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId, employeeId])
}

model PayrollRun {
  id            String           @id @default(uuid()) @db.Uuid
  schoolId      String           @db.Uuid
  periodStart   DateTime         @db.Date
  periodEnd     DateTime         @db.Date
  status        PayrollRunStatus @default(DRAFT)
  totalAmount   Decimal          @default(0) @db.Decimal(14, 2)
  employeeCount Int              @default(0)
  approvedById  String?          @db.Uuid
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  approvedBy User?         @relation("PayrollApprover", fields: [approvedById], references: [id])
  payouts   SalaryPayout[]

  @@index([schoolId, status])
  @@index([schoolId, periodStart])
}

model SalaryPayout {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @db.Uuid
  payrollRunId    String             @db.Uuid
  employeeId      String             @db.Uuid
  grossAmount     Decimal            @db.Decimal(12, 2)
  netAmount       Decimal            @db.Decimal(12, 2)
  deductions      Json               @default("{}")
  status          SalaryPayoutStatus @default(PENDING)
  razorpayPayoutId String?
  failureReason   String?
  idempotencyKey  String             @unique
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([payrollRunId])
  @@index([employeeId])
}

model SchoolPayoutConfig {
  id                       String   @id @default(uuid()) @db.Uuid
  schoolId                 String   @unique @db.Uuid
  razorpayXAccountNumber   String
  apiKeyEncrypted          String
  apiSecretEncrypted       String
  webhookSecretEncrypted   String?
  isEnabled                Boolean  @default(false)
  autoPayoutEnabled        Boolean  @default(false)
  payrollRunDay            Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolEmployeeJobTypeConfig {
  id                   String               @id @default(uuid()) @db.Uuid
  schoolId             String               @db.Uuid
  jobType              EmployeeJobType
  isEnabled            Boolean              @default(true)
  minimumLeaves        Int                  @default(0)
  leaveAllowancePeriod LeaveAllowancePeriod @default(MONTH)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, jobType])
  @@index([schoolId])
}

model SchoolCalendarDay {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  date         DateTime @db.Date
  isWorkingDay Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@index([schoolId, date])
}

model TransportRoute {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  description String?
  vehicleNo   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TransportRouteAssignment[]

  @@index([schoolId])
}

model TransportRouteAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  routeId   String   @db.Uuid
  employeeId String  @db.Uuid
  userId    String   @db.Uuid
  assignedAt DateTime @default(now())

  route    TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routeId, employeeId])
  @@index([employeeId])
}

model SecurityVisitorLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  loggedById  String   @db.Uuid
  visitorName String
  purpose     String
  phone       String?
  photoS3Key  String?
  checkInAt   DateTime @default(now())
  checkOutAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loggedBy User   @relation("SecurityVisitorLogger", fields: [loggedById], references: [id], onDelete: Cascade)

  @@index([schoolId, checkInAt])
}

model CleanerZoneAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  employeeId String   @db.Uuid
  zoneName   String
  tasks      Json     @default("[]")
  isComplete Boolean  @default(false)
  date       DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, zoneName, date])
  @@index([schoolId, date])
}

model SportsSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  title       String
  eventDate   DateTime @db.Date
  location    String?
  equipment   Json     @default("[]")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, eventDate])
}

model LibraryBook {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  title       String
  author      String?
  isbn        String?
  totalCopies Int      @default(1)
  available   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issues LibraryIssue[]

  @@index([schoolId])
}

model LibraryIssue {
  id         String    @id @default(uuid()) @db.Uuid
  bookId     String    @db.Uuid
  issuedTo   String
  issuedAt   DateTime  @default(now())
  dueDate    DateTime  @db.Date
  returnedAt DateTime?
  createdAt  DateTime  @default(now())

  book LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model StaffAttendance {
  id         String                @id @default(uuid()) @db.Uuid
  schoolId   String                @db.Uuid
  employeeId String                @db.Uuid
  userId     String                @db.Uuid
  date       DateTime              @db.Date
  status     StaffAttendanceStatus @default(PROCESSING)
  markedAt   DateTime?
  checkInAt  DateTime?
  geoLat     Float?
  geoLng     Float?
  method     String?
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  school   School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts StaffAttendanceAttempt[]

  @@unique([schoolId, employeeId, date])
  @@index([schoolId, date])
}

model StaffAttendanceAttempt {
  id                 String   @id @default(uuid()) @db.Uuid
  staffAttendanceId  String   @db.Uuid
  attemptNumber      Int
  success            Boolean  @default(false)
  geoLat             Float?
  geoLng             Float?
  evidenceImageKey   String?
  errorMessage       String?
  createdAt          DateTime @default(now())

  staffAttendance StaffAttendance @relation(fields: [staffAttendanceId], references: [id], onDelete: Cascade)

  @@index([staffAttendanceId])
}
