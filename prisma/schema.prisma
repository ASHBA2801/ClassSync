generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum PlanTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum LeaveRequesterType {
  TEACHER
  PARENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeacherAttendanceStatus {
  PROCESSING
  PRESENT
  FAILED
  ESCALATED
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeeInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  PHONEPE
  PAYPAL
  STRIPE
}

enum NotificationChannel {
  WEB_PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model School {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  timezone        String       @default("Asia/Kolkata")
  campusLat       Float?
  campusLng       Float?
  campusRadiusM   Int          @default(200)
  planTier        PlanTier     @default(BASIC)
  status          SchoolStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships         UserSchoolMembership[]
  students            Student[]
  grades              Grade[]
  classSections       ClassSection[]
  subjects            Subject[]
  gradeSubjects       GradeSubject[]
  teacherAssignments  TeacherAssignment[]
  scheduleSlots       ScheduleSlot[]
  scheduleConstraints ScheduleConstraint[]
  scheduleVersions    ScheduleVersion[]
  periodTimings       PeriodTiming[]
  teacherAttendances  TeacherAttendance[]
  studentAttendances  StudentAttendance[]
  leaveRequests       LeaveRequest[]
  documents           Document[]
  feeStructures       FeeStructure[]
  feeInvoices         FeeInvoice[]
  payments            Payment[]
  paymentProviders    SchoolPaymentProviderConfig[]
  notificationLogs    NotificationLog[]
  auditLogs           AuditLog[]
  aiServiceKeys       AIServiceKey[]
  pushSubscriptions   PushSubscription[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  faceImageKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           UserSchoolMembership[]
  guardianRelationships GuardianRelationship[]
  teacherAssignments    TeacherAssignment[]
  teacherAttendances    TeacherAttendance[]
  leaveRequests         LeaveRequest[]
  pushSubscriptions     PushSubscription[]
  auditLogs             AuditLog[]             @relation("AuditActor")
}

model UserSchoolMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  schoolId  String   @db.Uuid
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, role])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  role         Role
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  classSectionId String?  @db.Uuid
  name           String
  dob            DateTime?
  admissionNo    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection          ClassSection?          @relation(fields: [classSectionId], references: [id])
  guardianRelationships GuardianRelationship[]
  studentAttendances    StudentAttendance[]
  leaveRequests         LeaveRequest[]
  documents             Document[]
  feeInvoices           FeeInvoice[]

  @@index([schoolId])
  @@index([classSectionId])
}

model GuardianRelationship {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  parentId  String   @db.Uuid
  studentId String   @db.Uuid
  relation  String   @default("guardian")
  createdAt DateTime @default(now())

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([schoolId])
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSections  ClassSection[]
  gradeSubjects  GradeSubject[]
  feeStructures  FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSection {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  gradeId   String   @db.Uuid
  name      String
  grade     String
  section   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeRef           Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  students           Student[]
  teacherAssignments TeacherAssignment[]
  scheduleSlots      ScheduleSlot[]
  feeStructures      FeeStructure[]

  @@unique([schoolId, gradeId, section])
  @@index([schoolId])
  @@index([gradeId])
}

model GradeSubject {
  id             String @id @default(uuid()) @db.Uuid
  schoolId       String @db.Uuid
  gradeId        String @db.Uuid
  subjectId      String @db.Uuid
  periodsPerWeek Int    @default(5)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([gradeId, subjectId])
  @@index([schoolId])
}

model Subject {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  name           String
  code           String?
  periodsPerWeek Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  scheduleSlots      ScheduleSlot[]
  gradeSubjects      GradeSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  teacherId      String   @db.Uuid
  classSectionId String   @db.Uuid
  subjectId      String   @db.Uuid
  periodsPerWeek Int?
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classSectionId, subjectId])
  @@index([schoolId])
}

model PeriodTiming {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  periodNo  Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, periodNo])
}

model ScheduleVersion {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  version   Int
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheduleSlots ScheduleSlot[]

  @@unique([schoolId, version])
}

model ScheduleSlot {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  versionId      String   @db.Uuid
  dayOfWeek      Int
  periodNo       Int
  teacherId      String   @db.Uuid
  classSectionId String   @db.Uuid
  subjectId      String   @db.Uuid
  createdAt      DateTime @default(now())

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version      ScheduleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  classSection ClassSection    @relation(fields: [classSectionId], references: [id])
  subject      Subject         @relation(fields: [subjectId], references: [id])

  @@unique([versionId, dayOfWeek, periodNo, classSectionId])
  @@index([schoolId, teacherId])
}

model ScheduleConstraint {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  teacherId       String?  @db.Uuid
  minFreePeriods  Int      @default(1)
  maxFreePeriods  Int      @default(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId])
}

model TeacherAttendance {
  id        String                  @id @default(uuid()) @db.Uuid
  schoolId  String                  @db.Uuid
  teacherId String                  @db.Uuid
  date      DateTime                @db.Date
  status    TeacherAttendanceStatus @default(PROCESSING)
  markedAt  DateTime?
  geoLat    Float?
  geoLng    Float?
  method    String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher  User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attempts AttendanceAttempt[]

  @@unique([schoolId, teacherId, date])
  @@index([schoolId, date])
}

model AttendanceAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  teacherAttendanceId String   @db.Uuid
  attemptNumber       Int
  success             Boolean  @default(false)
  geoLat              Float?
  geoLng              Float?
  evidenceImageKey    String?
  errorMessage        String?
  createdAt           DateTime @default(now())

  teacherAttendance TeacherAttendance @relation(fields: [teacherAttendanceId], references: [id], onDelete: Cascade)

  @@index([teacherAttendanceId])
}

model StudentAttendance {
  id        String                  @id @default(uuid()) @db.Uuid
  schoolId  String                  @db.Uuid
  studentId String                  @db.Uuid
  date      DateTime                @db.Date
  status    StudentAttendanceStatus
  markedBy  String?                 @db.Uuid
  createdAt DateTime                @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, date])
  @@index([schoolId, date])
}

model LeaveRequest {
  id            String             @id @default(uuid()) @db.Uuid
  schoolId      String             @db.Uuid
  requesterId   String             @db.Uuid
  requesterType LeaveRequesterType
  studentId     String?            @db.Uuid
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String
  status        LeaveStatus        @default(PENDING)
  reviewedBy    String?            @db.Uuid
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requester User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id])

  @@index([schoolId, status])
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  schoolId   String         @db.Uuid
  studentId  String         @db.Uuid
  uploadedBy String         @db.Uuid
  name       String
  s3Key      String
  mimeType   String
  status     DocumentStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

model FeeStructure {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @db.Uuid
  name           String
  amount         Decimal   @db.Decimal(10, 2)
  gradeId        String?   @db.Uuid
  classSectionId String?   @db.Uuid
  termStart      DateTime?
  termEnd        DateTime?
  createdAt      DateTime  @default(now())

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade        Grade?        @relation(fields: [gradeId], references: [id])
  classSection ClassSection? @relation(fields: [classSectionId], references: [id])
  feeInvoices  FeeInvoice[]

  @@index([schoolId])
  @@index([gradeId])
}

model FeeInvoice {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  feeStructureId String           @db.Uuid
  amount         Decimal          @db.Decimal(10, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(10, 2)
  status         FeeInvoiceStatus @default(POSTED)
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  @@index([schoolId, status])
}

model Payment {
  id                 String           @id @default(uuid()) @db.Uuid
  schoolId           String           @db.Uuid
  feeInvoiceId       String           @db.Uuid
  amount             Decimal          @db.Decimal(10, 2)
  status             PaymentStatus    @default(PENDING)
  provider           PaymentProvider?
  externalOrderId    String?
  externalPaymentId  String?          @unique
  receiptUrl         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id])

  @@index([schoolId])
  @@index([externalOrderId])
}

model SchoolPaymentProviderConfig {
  id                     String          @id @default(uuid()) @db.Uuid
  schoolId               String          @db.Uuid
  provider               PaymentProvider
  isEnabled              Boolean         @default(true)
  publicKey              String
  secretEncrypted        String
  webhookSecretEncrypted String?
  configJson             Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
  @@index([schoolId])
}

model AIServiceKey {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @db.Uuid
  provider     String
  keyEncrypted String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@index([provider, schoolId])
}

model NotificationLog {
  id        String              @id @default(uuid()) @db.Uuid
  schoolId  String              @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  metadata  Json?
  createdAt DateTime            @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  schoolId  String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String?  @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
  actor  User    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([schoolId, createdAt])
  @@index([actorId])
}
