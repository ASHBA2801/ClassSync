generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id            String   @id
  name          String
  code          String
  studentsCount Int
  location      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  students         Student[]
  grades           Grade[]
  attendances      Attendance[]
  homework         Homework[]
  fees             Fee[]
  behavioralNotes  BehavioralNote[]
  alerts           Alert[]
  staff            Staff[]
  rooms            Room[]
  subjects         Subject[]
  timetableSlots   TimetableSlot[]
  documents        Document[]
}

model Staff {
  id              String @id @default(cuid())
  schoolId        String
  name            String
  email           String
  phone           String @default("")
  department      String
  qualification   String @default("")
  subjects        String[] // list of subject IDs they can teach
  availability    Json   // { "Mon": ["P1","P2"], "Tue": [...], ... }
  joinDate        String
  status          String @default("Active")

  school          School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots  TimetableSlot[]

  @@index([schoolId])
}

model Room {
  id             String @id @default(cuid())
  schoolId       String
  name           String
  capacity       Int
  type           String // "Classroom" | "Lab" | "Auditorium" | "Library"
  floor          String @default("Ground")
  facilities     String[] // ["Projector", "AC", "Smart Board"]
  status         String @default("Available")

  school         School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]

  @@index([schoolId])
}

model Subject {
  id             String @id @default(cuid())
  schoolId       String
  name           String
  code           String
  hoursPerWeek   Int    @default(5)
  grade          String // which grade/class this is for
  department     String @default("General")

  school         School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]

  @@index([schoolId])
}

model TimetableSlot {
  id         String  @id @default(cuid())
  schoolId   String
  classSection String  // e.g. "10-A"
  day        String  // "Mon" | "Tue" | "Wed" | "Thu" | "Fri"
  period     Int     // 1-8
  startTime  String  // "09:00"
  endTime    String  // "10:00"
  staffId    String?
  roomId     String?
  subjectId  String?
  subjectName String @default("")
  staffName   String @default("")
  roomName    String @default("")
  status     String @default("Scheduled") // "Scheduled" | "Conflict" | "Free"
  conflictReason String @default("")

  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  room       Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([schoolId, day, period, classSection])
  @@index([schoolId])
}

model Document {
  id              String   @id @default(cuid())
  schoolId        String
  fileName        String
  formType        String   // "admission" | "id_proof" | "marksheet" | "leave_application"
  uploadedBy      String   @default("Admin")
  uploadedAt      DateTime @default(now())
  status          String   @default("Pending") // "Pending" | "Processing" | "Reviewed" | "Written_to_ERP"
  extractedData   Json?    // structured fields extracted by AI
  confidence      Float    @default(0)
  reviewNotes     String   @default("")
  linkedStudentId String?  // after ERP write

  school          School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Student {
  id             String  @id
  schoolId       String
  name           String
  grade          String
  parentName     String
  parentEmail    String
  attendanceRate Float
  gpa            String
  status         String

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades      Grade[]
  attendances Attendance[]
  fees        Fee[]
  notes       BehavioralNote[]

  @@index([schoolId])
}

model Grade {
  id          String @id @default(cuid())
  schoolId    String
  studentId   String
  studentName String
  subject     String
  score       Float
  total       Float  @default(100)
  date        String
  teacher     String
  feedback    String @default("")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
}

model Attendance {
  id          String @id @default(cuid())
  schoolId    String
  studentId   String
  studentName String
  date        String
  status      String
  session     String @default("Morning")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, date])
  @@index([schoolId])
}

model Homework {
  id              String   @id @default(cuid())
  schoolId        String
  title           String
  subject         String
  dueDate         String
  status          String
  assignedTo      String
  overdueDays     Int      @default(0)
  pendingStudents String[]

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Fee {
  id            String @id @default(cuid())
  schoolId      String
  studentId     String
  studentName   String
  amount        Float
  dueDate       String
  status        String
  daysRemaining Int
  parentContact String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model BehavioralNote {
  id          String @id @default(cuid())
  schoolId    String
  studentId   String
  studentName String
  note        String
  date        String
  author      String
  sentiment   String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Alert {
  id          String  @id @default(cuid())
  schoolId    String?
  agentName   String
  agentIcon   String
  title       String
  message     String
  severity    String
  timestamp   String
  status      String  @default("Active")
  actionTaken String

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AgentConfig {
  id             String  @id
  name           String
  icon           String
  trigger        String
  action         String
  active         Boolean @default(true)
  executionCount Int     @default(0)
  lastRun        String
}

model AgentLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  agent     String
  message   String
  status    String
}
