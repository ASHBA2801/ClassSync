# Copy to .env after starting Docker services:
#   docker compose up -d
#   cp .env.docker .env

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classsync
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-to-a-long-random-string-in-production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=classsync-uploads
S3_ENDPOINT=http://localhost:9000
FACE_PROVIDER=mock
RAZORPAY_PLATFORM_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@classsync.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
WORKER_URL=http://localhost:3001
WORKER_SECRET=dev-worker-secret
